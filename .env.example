# Server Configuration
PORT=3000

# Personal Phone Number to Receive Event SMS Texts (Google Fi / US 10-digit or E.164 format, e.g. 555-123-4567)
NOTIFY_PHONE_NUMBER=

# Carrier Profile (optimized for Google Fi)
USER_CARRIER=google_fi

# Notification Channels ("sms", "whatsapp", or "both")
NOTIFICATION_CHANNELS=sms

# Textbelt API Key for SMS Delivery (https://textbelt.com — defaults to "textbelt" free test key if left blank)
TEXTBELT_API_KEY=textbelt

# Comma-separated list of WhatsApp chat/group names or JIDs to monitor (leave * to monitor all chats)
WATCHED_CHATS=*

# Event Detection Mode ("hybrid", "ai", or "rules")
DETECTION_MODE=hybrid

# Optional: AI API Keys for natural-language event extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
