# Server Configuration
PORT=3000

# Personal Phone Number to Receive Event Notifications (E.164 format, e.g. +15551234567)
NOTIFY_PHONE_NUMBER=+15551234567

# Notification Channels ("whatsapp", "sms", or "both")
NOTIFICATION_CHANNELS=whatsapp

# Comma-separated list of WhatsApp chat/group names or JIDs to monitor (leave * to monitor all chats)
WATCHED_CHATS=*

# Event Detection Mode ("hybrid", "ai", or "rules")
DETECTION_MODE=hybrid

# Optional: AI API Keys for natural-language event extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Twilio Credentials for SMS notifications to personal phone number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
